{
  "name": "lead-finder",
  "version": "1.0.0",
  "description": "Desktop lead finder for public Myfxbook profiles",
  "author": "arturious",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "node scripts/start.js",
    "test": "node --test test/",
    "build": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac zip --arm64"
  },
  "dependencies": {
    "cloakbrowser": "0.7.2",
    "playwright-core": "1.64.0"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.leadfinder.app",
    "productName": "Lead Finder",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "gatekeeperAssess": false,
      "hardenedRuntime": false,
      "artifactName": "Lead-Finder-${arch}-mac.${ext}"
    }
  }
}
